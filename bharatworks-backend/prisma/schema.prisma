// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// For Prisma 7.x: Database URL moved to prisma.config.ts
// This schema only defines the data models

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // URL is now defined in prisma.config.ts for Prisma 7.x compatibility
  url = env("DATABASE_URL")
}

model User {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phone             String?      @unique
  name              String?
  password          String?      // Replaces Supabase Auth password management
  roles             String[]     @default([])
  agentTrustLevel   Int?         @default(0) @map("agent_trust_level")
  email             String       @unique
  kycStatus         String?      @map("kyc_status")
  balance           Decimal?     @default(0.00) @db.Decimal(12, 2)
  fcmToken          String?      @map("fcm_token")
  photoUrl          String?      @map("photo_url")
  createdAt         DateTime     @default(now()) @map("created_at")
  lastLogin         DateTime?    @map("last_login")

  agents            Agent[]
  employers         Employer[]
  workers           Worker[]
  paymentsMade      Payment[]    @relation("Payer")
  paymentsReceived  Payment[]    @relation("Payee")
  disputesRaised    Dispute[]    @relation("DisputeRaisedBy")

  @@map("users")
}

model Agent {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String       @map("user_id") @db.Uuid
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  operationalArea   String?      @map("operational_area")
  createdAt         DateTime     @default(now()) @map("created_at")

  workersCreated    Worker[]

  @@map("agents")
}

model Employer {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String       @map("user_id") @db.Uuid
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  employerType      String?      @map("employer_type")
  companyName       String?      @map("company_name")
  billingAddress    String?      @map("billing_address")
  createdAt         DateTime     @default(now()) @map("created_at")

  jobs              Job[]
  attendances       Attendance[]
  workerDues        WorkerDue[]

  @@map("employers")
}

model Worker {
  id                  String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String       @map("user_id") @db.Uuid
  user                User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone               String?
  expectedWage        Decimal?     @map("expected_wage") @db.Decimal(10, 2)
  createdByAgentId    String?      @map("created_by_agent_id") @db.Uuid
  agent               Agent?       @relation(fields: [createdByAgentId], references: [id])
  verificationStatus  String?      @map("verification_status")
  latitude            Float?
  longitude           Float?
  geohash             String?
  documents           Json?
  reliabilityScore    Float?       @default(0) @map("reliability_score")
  acceptanceRate      Float?       @default(0) @map("acceptance_rate")
  availabilityStatus  String?      @map("availability_status")
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @default(now()) @updatedAt @map("updated_at")

  reservations        Reservation[]
  checkins            Checkin[]
  attendances         Attendance[]
  workerDues          WorkerDue[]

  @@index([geohash])
  @@index([availabilityStatus])
  @@map("workers")
}

model Job {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employerId        String       @map("employer_id") @db.Uuid
  employer          Employer     @relation(fields: [employerId], references: [id], onDelete: Cascade)
  title             String
  count             Int
  wagePerDay        Decimal      @map("wage_per_day") @db.Decimal(10, 2)
  lat               Float?
  lng               Float?
  geohash           String?
  status            String
  urgent            Boolean?     @default(false)
  createdAt         DateTime     @default(now()) @map("created_at")
  startTime         DateTime?    @map("start_time")
  endTime           DateTime?    @map("end_time")
  slotsTotal        Int          @map("slots_total")
  slotsReserved     Int          @default(0) @map("slots_reserved")

  reservations      Reservation[]
  checkins          Checkin[]
  payments          Payment[]
  disputes          Dispute[]
  attendances       Attendance[]

  @@index([geohash])
  @@index([status])
  @@map("jobs")
}

model Reservation {
  id                      String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobId                   String       @map("job_id") @db.Uuid
  job                     Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  workerId                String       @map("worker_id") @db.Uuid
  worker                  Worker       @relation(fields: [workerId], references: [id], onDelete: Cascade)
  status                  String
  reservedAt              DateTime     @default(now()) @map("reserved_at")
  expiryAt                DateTime?    @map("expiry_at")
  checkinDeadlineSeconds  Int?         @map("checkin_deadline_seconds")
  checkinMethods          String[]     @map("checkin_methods")
  idempotencyKey          String       @unique @map("idempotency_key")

  checkins                Checkin[]

  @@map("reservations")
}

model Checkin {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reservationId    String       @map("reservation_id") @db.Uuid
  reservation      Reservation  @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  jobId            String       @map("job_id") @db.Uuid
  job              Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  workerId         String       @map("worker_id") @db.Uuid
  worker           Worker       @relation(fields: [workerId], references: [id], onDelete: Cascade)
  checkinTime      DateTime     @default(now()) @map("checkin_time")
  method           String?
  lat              Float?
  lng              Float?
  photoRef         String?      @map("photo_ref")

  @@map("checkins")
}

model Payment {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobId             String?      @map("job_id") @db.Uuid
  job               Job?         @relation(fields: [jobId], references: [id], onDelete: SetNull)
  payerId           String       @map("payer_id") @db.Uuid
  payer             User         @relation("Payer", fields: [payerId], references: [id])
  payeeId           String       @map("payee_id") @db.Uuid
  payee             User         @relation("Payee", fields: [payeeId], references: [id])
  amount            Decimal      @db.Decimal(12, 2)
  method            String?
  status            String
  providerTxnId     String?      @map("provider_txn_id")
  razorpayOrderId   String?      @map("razorpay_order_id")
  razorpayPaymentId String?      @map("razorpay_payment_id")
  createdAt         DateTime     @default(now()) @map("created_at")
  confirmedAt       DateTime?    @map("confirmed_at")
  idempotencyKey    String       @unique @map("idempotency_key")

  @@index([jobId])
  @@index([status])
  @@map("payments")
}

model Dispute {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobId            String       @map("job_id") @db.Uuid
  job              Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  raisedById       String       @map("raised_by") @db.Uuid
  raisedBy         User         @relation("DisputeRaisedBy", fields: [raisedById], references: [id])
  reason           String?
  evidence         Json?
  status           String
  createdAt        DateTime     @default(now()) @map("created_at")
  resolvedAt       DateTime?    @map("resolved_at")

  @@map("disputes")
}

model OtpLog {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phone     String?
  email     String?
  otp       String
  expiresAt DateTime  @map("expires_at")
  used      Boolean   @default(false)
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([phone])
  @@index([email])
  @@map("otp_logs")
}

// Daily attendance records for traditional attendance register
model Attendance {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workerId        String       @map("worker_id") @db.Uuid
  worker          Worker       @relation(fields: [workerId], references: [id], onDelete: Cascade)
  jobId           String?      @map("job_id") @db.Uuid
  job             Job?         @relation(fields: [jobId], references: [id], onDelete: SetNull)
  employerId      String       @map("employer_id") @db.Uuid
  employer        Employer     @relation(fields: [employerId], references: [id], onDelete: Cascade)
  date            DateTime     @db.Date
  status          String       // PRESENT, HALF, ABSENT, PENDING
  checkinTime     DateTime?    @map("checkin_time")
  checkoutTime    DateTime?    @map("checkout_time")
  wage            Decimal?     @db.Decimal(10, 2)
  amountPaid      Decimal      @default(0) @map("amount_paid") @db.Decimal(10, 2)
  paymentStatus   String       @default("UNPAID") @map("payment_status") // UNPAID, PARTIAL, PAID
  notes           String?
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  @@unique([workerId, date])
  @@index([workerId, date])
  @@index([employerId, date])
  @@index([jobId])
  @@map("attendances")
}

// Worker dues/Outstanding payments tracking
model WorkerDue {
  id                  String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workerId            String       @map("worker_id") @db.Uuid
  worker              Worker       @relation(fields: [workerId], references: [id], onDelete: Cascade)
  employerId          String       @map("employer_id") @db.Uuid
  employer            Employer     @relation(fields: [employerId], references: [id], onDelete: Cascade)
  totalEarned         Decimal      @default(0) @map("total_earned") @db.Decimal(12, 2)
  totalPaid           Decimal      @default(0) @map("total_paid") @db.Decimal(12, 2)
  balanceDue          Decimal      @default(0) @map("balance_due") @db.Decimal(12, 2)
  lastPaymentDate     DateTime?    @map("last_payment_date")
  updatedAt           DateTime     @updatedAt @map("updated_at")

  @@unique([workerId, employerId])
  @@index([workerId])
  @@index([employerId])
  @@map("worker_dues")
}
